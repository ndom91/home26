{
  "name": "home26",
  "type": "module",
  "imports": {
    "#/*": "./src/*",
    "#content/*": "./content/*"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "description": "ndom91 portfolio page",
  "license": "MIT",
  "author": "ndom91 <yo@ndo.dev>",
  "homepage": "https://ndo.dev/",
  "bugs": "https://github.com/ndom91/home26/issues",
  "repository": "https://github.com/ndom91/home26",
  "keywords": [
    "tanstack",
    "tailwindcss",
    "blog",
    "portfolio"
  ],
  "scripts": {
    "dev": "vite dev",
    "mermaid": "node scripts/render-mermaid.ts",
    "stars": "node scripts/fetch-stars.ts",
    "sign-screenshots": "node scripts/sign-link-screenshots.ts",
    "refresh-generated": "pnpm run stars && pnpm run sign-screenshots",
    "warm": "node scripts/warm-link-screenshots.ts",
    "atproto:publish": "node scripts/publish-standard-site.ts",
    "build": "content-collections build && vite build",
    "preview": "vite preview",
    "deploy": "wrangler deploy && (pnpm run warm || true)",
    "cf:typegen": "wrangler types",
    "cf:logs": "pnpm wrangler tail home26",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "content-collections build && tsgo --noEmit",
    "lint": "pnpm biome check",
    "lint:fix": "pnpm run lint --write",
    "format": "biome check .",
    "format:fix": "biome check --write ."
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "1.42.2",
    "@mdx-js/rollup": "3.1.1",
    "@tailwindcss/vite": "4.3.1",
    "@tanstack/react-devtools": "0.10.8",
    "@tanstack/react-router": "1.170.16",
    "@tanstack/react-router-devtools": "1.167.0",
    "@tanstack/react-start": "1.168.26",
    "@tanstack/router-plugin": "1.168.18",
    "lucide-react": "1.21.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-medium-image-zoom": "5.4.8",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "7.1.0",
    "rehype-callouts": "2.2.0",
    "rehype-pretty-code": "0.14.3",
    "rehype-slug": "6.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx-frontmatter": "5.2.0",
    "shiki": "4.2.0",
    "tailwindcss": "4.3.1",
    "valibot": "1.4.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@content-collections/cli": "0.1.9",
    "@content-collections/core": "0.15.2",
    "@content-collections/vite": "0.3.0",
    "@tailwindcss/typography": "0.5.20",
    "@tanstack/devtools-vite": "0.8.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/mdx": "2.0.14",
    "@types/node": "26.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260624.1",
    "@vitejs/plugin-react": "6.0.3",
    "jsdom": "29.1.1",
    "rehype-mdx-import-media": "1.4.0",
    "vite": "8.1.0",
    "vitest": "4.1.9",
    "wrangler": "4.104.0"
  },
  "packageManager": "pnpm@11.5.2+sha512.71c631e382066efc25625d5cf029075de07b61b37f6e27350fbd84b1bda5864c8c1967adc280776b45c30a715c0359a3be08fef42d5bb09e2b99029979692916"
}
