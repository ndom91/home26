{
  "name": "home26",
  "type": "module",
  "imports": {
    "#/*": "./src/*",
    "#content/*": "./content/*"
  },
  "description": "ndom91 portfolio page",
  "license": "MIT",
  "author": "ndom91 <yo@ndo.dev>",
  "homepage": "https://ndo.dev/",
  "bugs": "https://github.com/ndom91/home26/issues",
  "repository": "https://github.com/ndom91/home26",
  "keywords": [
    "tanstack",
    "tailwindcss",
    "blog",
    "portfolio"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "content-collections build && vite build",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "test": "vitest run",
    "typecheck": "content-collections build && tsgo --noEmit",
    "lint": "pnpm biome check",
    "lint:fix": "pnpm run lint --write",
    "format": "biome check .",
    "format:fix": "biome check --write ."
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "1.36.3",
    "@mdx-js/react": "3.1.1",
    "@mdx-js/rollup": "3.1.1",
    "@tailwindcss/vite": "4.3.0",
    "@tanstack/react-devtools": "0.10.2",
    "@tanstack/react-query": "5.100.9",
    "@tanstack/react-query-devtools": "5.100.9",
    "@tanstack/react-router": "1.169.2",
    "@tanstack/react-router-devtools": "1.166.13",
    "@tanstack/react-router-ssr-query": "1.166.12",
    "@tanstack/react-start": "1.167.65",
    "@tanstack/router-plugin": "1.167.35",
    "gray-matter": "4.0.3",
    "lucide-react": "0.545.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "rehype-autolink-headings": "7.1.0",
    "rehype-pretty-code": "0.14.3",
    "rehype-slug": "6.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx-frontmatter": "5.2.0",
    "shiki": "4.0.2",
    "tailwindcss": "4.3.0",
    "valibot": "1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@content-collections/cli": "0.1.9",
    "@content-collections/core": "0.15.1",
    "@content-collections/vite": "0.3.0",
    "@tailwindcss/typography": "0.5.19",
    "@tanstack/devtools-vite": "0.6.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/mdx": "2.0.13",
    "@types/node": "22.19.18",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260509.2",
    "@vitejs/plugin-react": "6.0.1",
    "jsdom": "28.1.0",
    "rehype-mdx-import-media": "1.4.0",
    "vite": "8.0.11",
    "vitest": "4.1.5",
    "wrangler": "4.90.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
